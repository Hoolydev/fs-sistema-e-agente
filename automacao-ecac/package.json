{
  "name": "fs-automacao-ecac",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "migrate": "tsx src/db/migrate.ts",
    "demo": "tsx scripts/demo.ts",
    "validate:openai": "tsx scripts/validate-openai.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1128.0",
    "bullmq": "6.3.4",
    "fastify": "5.12.3",
    "fastify-raw-body": "5.0.0",
    "ioredis": "5.7.0",
    "pdf-parse": "2.4.5",
    "pg": "8.16.3",
    "pino": "9.9.5",
    "playwright": "1.63.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/pg": "8.15.5",
    "pino-pretty": "13.1.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
