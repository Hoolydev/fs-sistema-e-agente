# Copiar para /opt/fs-evolution/.env (modo 600). Gerar AUTHENTICATION_API_KEY com `openssl rand -hex 32`
# e a senha do banco em secrets/pg_password com `openssl rand -hex 24` (a mesma senha vai na URI abaixo).
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://fs-evolution-api-1:8080
LANGUAGE=pt-BR
AUTHENTICATION_API_KEY=
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false
DEL_INSTANCE=false
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:SENHA@fs-evolution-postgres-1:5432/evolution?schema=evolution_api
DATABASE_CONNECTION_CLIENT_NAME=fs_agente
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://fs-evolution-redis-1:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false
WEBHOOK_GLOBAL_ENABLED=false
CONFIG_SESSION_PHONE_CLIENT=FS Agente
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30
LOG_LEVEL=ERROR,WARN,INFO
LOG_BAILEYS=error
TELEMETRY_ENABLED=false
