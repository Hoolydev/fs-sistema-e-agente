NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Provedor: meta ou zapi
WHATSAPP_PROVIDER=meta
WHATSAPP_DRY_RUN=true
AUTHORIZED_PHONE_NUMBERS=5562999999999

# Meta WhatsApp Cloud API (usado quando WHATSAPP_PROVIDER=meta)
WHATSAPP_VERIFY_TOKEN=troque-por-token-longo
WHATSAPP_APP_SECRET=troque-pelo-app-secret
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v25.0

# Z-API (usado quando WHATSAPP_PROVIDER=zapi)
ZAPI_BASE_URL=https://api.z-api.io
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
ZAPI_CLIENT_TOKEN=
# Gere com: openssl rand -hex 32
ZAPI_WEBHOOK_TOKEN=

# Análise fiscal por LLM. A chave fica em arquivo secreto, não neste .env.
LLM_PROVIDER=disabled
LLM_MODEL=gpt-5.5
LLM_API_KEY_FILE=/run/secrets/openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_REQUEST_TIMEOUT_MS=180000
LLM_MAX_INPUT_CHARS=120000

# Infraestrutura local
DATABASE_URL=postgres://ecac:ecac@localhost:5432/ecac
REDIS_URL=redis://localhost:6379
DOCUMENT_STORAGE_MODE=local
LOCAL_DOCUMENT_DIR=./data/documents

# Contabo Object Storage ou outro S3 compatível
S3_ENDPOINT=
S3_REGION=default
S3_BUCKET=fs-ecac-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Gere com: openssl rand -base64 32
DOCUMENT_ENCRYPTION_KEY_BASE64=

# RPA: use mock até termos certificado e fluxo homologado
RPA_MODE=mock
ECAC_LOGIN_URL=https://cav.receita.fazenda.gov.br/autenticacao/login
ECAC_CLIENT_CERT_ORIGINS=https://certificado.sso.acesso.gov.br,https://certificado.sso.staging.acesso.gov.br
ECAC_CDP_URL=
CERTIFICATE_PROVIDER=local
CERT_PFX_PATH=
CERT_PFX_PASSPHRASE=
# Na VPS, prefira arquivo separado montado somente no worker.
CERT_PFX_PASSPHRASE_FILE=

# Retenção e execução
DOCUMENT_RETENTION_DAYS=30
RPA_JOB_TIMEOUT_MS=180000
# Tempo para o operador resolver CAPTCHA na sessão remota (10 minutos).
HUMAN_INTERVENTION_TIMEOUT_MS=600000

# Coleta oficial Serpro. rpa preserva o fluxo anterior; serpro nunca usa fallback RPA/mock.
FISCAL_DATA_PROVIDER=rpa
# Ativar somente após contratação, instalação das chaves e conferência das procurações.
SERPRO_ENABLED=false
SERPRO_CONTRACTOR_CNPJ=
SERPRO_AUTHOR_CNPJ=
SERPRO_CONSUMER_KEY_FILE=/run/secrets/serpro_consumer_key
SERPRO_CONSUMER_SECRET_FILE=/run/secrets/serpro_consumer_secret
SERPRO_REQUEST_TIMEOUT_MS=60000
SERPRO_POLL_TIMEOUT_MS=180000
SERPRO_MAX_POLL_ATTEMPTS=6

# Acervo compartilhado: mesmo token de FS_AGENT_SERVICE_TOKEN no sistema
FS_SYSTEM_URL=https://app.fssolucoestributarias.com.br
FS_SYSTEM_API_TOKEN=
