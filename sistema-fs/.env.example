# Desenvolvimento: preencher com banco isolado. Autenticação sempre requer PostgreSQL.
DATABASE_URL=postgres://ecac:ecac@localhost:5432/ecac
# Opcional: banco separado de autenticação ou CRM
FS_AUTH_DATABASE_URL=
FS_CRM_DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3100
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3100
# Gerar: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Site -> sistema: valores iguais aos correspondentes no site
FS_DIAGNOSTIC_WEBHOOK_TOKEN=
FS_DIAGNOSTIC_WEBHOOK_SECRET=

# Agente -> acervo: igual a FS_SYSTEM_API_TOKEN no agente
FS_AGENT_SERVICE_TOKEN=
# Números autorizados com DDI, separados por vírgula; nunca habilitar todos
FS_AGENT_ALLOWED_PHONES=

# Diagnóstico preliminar pelo botão "Analisar CNPJ" (PGFN sem procuração).
# Credenciais do contrato Serpro "Consulta Dívida Ativa" (na VPS: /opt/fs-automacao-ecac/secrets/serpro-divida-ativa/)
SERPRO_DIVIDA_CONSUMER_KEY=
SERPRO_DIVIDA_CONSUMER_SECRET=
# CNPJ da FS que recebe a procuração eletrônica no e-CAC (padrão 47733961000179)
FS_PROCURADOR_CNPJ=
# Janela em horas para reaproveitar um parecer do mesmo CNPJ sem nova consulta cobrada (padrão 24; 0 desativa)
FS_DIAGNOSTIC_REUSE_HOURS=
# Opcional: base pública de cadastro CNPJ (padrão https://brasilapi.com.br/api/cnpj/v1)
FS_CADASTRO_PROVIDER_URL=
